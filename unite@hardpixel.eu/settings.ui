<?xml version="1.0" encoding="UTF-8"?>
<interface domain="unite">
  <requires lib="gtk" version="4.0"/>
  <object class="GtkAdjustment" id="maxwidth_appmenu_adjustment">
    <property name="upper">1000</property>
    <property name="step-increment">1</property>
    <property name="page-increment">10</property>
  </object>
  <object class="GtkAdjustment" id="compact_hover_delay_adjustment">
    <property name="upper">5000</property>
    <property name="step-increment">50</property>
    <property name="page-increment">250</property>
  </object>
  <object class="GtkAdjustment" id="window_buttons_hover_delay_adjustment">
    <property name="upper">5000</property>
    <property name="step-increment">50</property>
    <property name="page-increment">250</property>
  </object>
  <object class="GtkAdjustment" id="workspace_buttons_animation_duration_adjustment">
    <property name="upper">2000</property>
    <property name="step-increment">25</property>
    <property name="page-increment">100</property>
  </object>
  <object class="GtkAdjustment" id="compact_threshold_adjustment">
    <property name="upper">2000</property>
    <property name="step-increment">1</property>
    <property name="page-increment">10</property>
  </object>
  <object class="AdwPreferencesPage" id="general_page">
    <property name="name">general-page</property>
    <property name="title" translatable="yes">General</property>
    <property name="icon-name">emblem-system-symbolic</property>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Layout Tweaks</property>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Extend panel left box</property>
            <property name="subtitle" translatable="yes">Extend top panel left box</property>
            <property name="activatable-widget">extend_left_box</property>
            <child>
              <object class="GtkSwitch" id="extend_left_box">
                <property name="valign">center</property>
                <property name="active">1</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Reduce panel spacing</property>
            <property name="subtitle" translatable="yes">Reduce top panel icons and buttons spacing</property>
            <property name="activatable-widget">reduce_panel_spacing</property>
            <child>
              <object class="GtkSwitch" id="reduce_panel_spacing">
                <property name="valign">center</property>
                <property name="active">1</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Notifications position</property>
            <property name="subtitle" translatable="yes">System notification messages position</property>
            <property name="activatable-widget">notifications_position</property>
            <child>
              <object class="GtkComboBoxText" id="notifications_position">
                <property name="valign">center</property>
                <property name="width-request">130</property>
                <property name="active-id">2</property>
                <items>
                  <item id="0" translatable="yes">Center</item>
                  <item id="1" translatable="yes">Left</item>
                  <item id="2" translatable="yes">Right</item>
                </items>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">System Tray</property>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Enable tray</property>
            <property name="subtitle" translatable="yes">Show system tray in top panel</property>
            <property name="activatable-widget">show_legacy_tray</property>
            <child>
              <object class="GtkSwitch" id="show_legacy_tray">
                <property name="valign">center</property>
                <property name="active">1</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Greyscale icons</property>
            <property name="subtitle" translatable="yes">Convert tray icons to greyscale</property>
            <property name="activatable-widget">greyscale_tray_icons</property>
            <child>
              <object class="GtkSwitch" id="greyscale_tray_icons">
                <property name="valign">center</property>
                <property name="active">1</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Application Menu</property>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Enable appmenu</property>
            <property name="subtitle" translatable="yes">Show appmenu button in top panel</property>
            <property name="activatable-widget">show_appmenu_button</property>
            <child>
              <object class="GtkSwitch" id="show_appmenu_button">
                <property name="valign">center</property>
                <property name="active">1</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">App menu position</property>
            <property name="subtitle" translatable="yes">App menu position in the top panel</property>
            <property name="activatable-widget">app_menu_panel_placement</property>
            <child>
              <object class="GtkComboBoxText" id="app_menu_panel_placement">
                <property name="valign">center</property>
                <property name="width-request">150</property>
                <property name="active-id">1</property>
                <items>
                  <item id="0" translatable="yes">First</item>
                  <item id="1" translatable="yes">Left</item>
                  <item id="2" translatable="yes">Right</item>
                  <item id="3" translatable="yes">Last</item>
                </items>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow" id="app_menu_placement_row">
            <property name="title" translatable="yes">Position relative to buttons</property>
            <property name="subtitle" translatable="yes">Place the app menu before or after combined window controls</property>
            <property name="activatable-widget">app_menu_placement</property>
            <child>
              <object class="GtkComboBoxText" id="app_menu_placement">
                <property name="valign">center</property>
                <property name="width-request">130</property>
                <property name="active-id">0</property>
                <items>
                  <item id="0" translatable="yes">Auto</item>
                  <item id="1" translatable="yes">Before</item>
                  <item id="2" translatable="yes">After</item>
                </items>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Compact when cramped</property>
            <property name="subtitle" translatable="yes">Show only the icon until you hover over the app menu</property>
            <property name="activatable-widget">compact_app_menu_button</property>
            <child>
              <object class="GtkSwitch" id="compact_app_menu_button">
                <property name="valign">center</property>
                <property name="active">0</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Compact hover delay</property>
            <property name="subtitle" translatable="yes">Delay before a compact app menu unfolds</property>
            <property name="activatable-widget">compact_app_menu_hover_delay</property>
            <child>
              <object class="GtkSpinButton" id="compact_app_menu_hover_delay">
                <property name="valign">center</property>
                <property name="width-request">130</property>
                <property name="text">350</property>
                <property name="adjustment">compact_hover_delay_adjustment</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Compact threshold</property>
            <property name="subtitle" translatable="yes">Extra pixels required before the app menu stays expanded</property>
            <property name="activatable-widget">compact_app_menu_threshold</property>
            <child>
              <object class="GtkSpinButton" id="compact_app_menu_threshold">
                <property name="valign">center</property>
                <property name="width-request">130</property>
                <property name="text">0</property>
                <property name="adjustment">compact_threshold_adjustment</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Maximum width</property>
            <property name="subtitle" translatable="yes">Maximum width for the appmenu button label</property>
            <property name="activatable-widget">app_menu_max_width</property>
            <child>
              <object class="GtkSpinButton" id="app_menu_max_width">
                <property name="valign">center</property>
                <property name="width-request">130</property>
                <property name="text">0</property>
                <property name="adjustment">maxwidth_appmenu_adjustment</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Text ellipsis</property>
            <property name="subtitle" translatable="yes">Text ellipsis mode for appmenu button label</property>
            <property name="activatable-widget">app_menu_ellipsize_mode</property>
            <child>
              <object class="GtkComboBoxText" id="app_menu_ellipsize_mode">
                <property name="valign">center</property>
                <property name="width-request">130</property>
                <property name="active-id">2</property>
                <items>
                  <item id="0" translatable="yes">Start</item>
                  <item id="1" translatable="yes">Middle</item>
                  <item id="2" translatable="yes">End</item>
                </items>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Disable icon</property>
            <property name="subtitle" translatable="yes">Hide application icon in appmenu button</property>
            <property name="activatable-widget">hide_app_menu_icon</property>
            <child>
              <object class="GtkSwitch" id="hide_app_menu_icon">
                <property name="valign">center</property>
                <property name="active">1</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Workspace Switcher</property>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Use text button</property>
            <property name="subtitle" translatable="yes">Revive old activities text button</property>
            <property name="activatable-widget">use_activities_text</property>
            <child>
              <object class="GtkSwitch" id="use_activities_text">
                <property name="valign">center</property>
                <property name="active">1</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Panel position</property>
            <property name="subtitle" translatable="yes">Workspace switcher position in the top panel</property>
            <property name="activatable-widget">workspace_switcher_placement</property>
            <child>
              <object class="GtkComboBoxText" id="workspace_switcher_placement">
                <property name="valign">center</property>
                <property name="width-request">130</property>
                <property name="active-id">2</property>
                <items>
                  <item id="0" translatable="yes">Absolutely First</item>
                  <item id="1" translatable="yes">Left</item>
                  <item id="2" translatable="yes">Right</item>
                  <item id="3" translatable="yes">Absolutely Last</item>
                </items>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Hide switcher</property>
            <property name="subtitle" translatable="yes">Hide workspace switcher button</property>
            <property name="activatable-widget">hide_activities_button</property>
            <child>
              <object class="GtkComboBoxText" id="hide_activities_button">
                <property name="valign">center</property>
                <property name="width-request">130</property>
                <property name="active-id">1</property>
                <items>
                  <item id="0" translatable="yes">Never</item>
                  <item id="1" translatable="yes">Auto</item>
                  <item id="2" translatable="yes">Always</item>
                </items>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Panel Items</property>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Clock position</property>
            <property name="subtitle" translatable="yes">Clock position in the top panel</property>
            <property name="activatable-widget">clock_placement</property>
            <child>
              <object class="GtkComboBoxText" id="clock_placement">
                <property name="valign">center</property>
                <property name="width-request">150</property>
                <property name="active-id">2</property>
                <items>
                  <item id="0" translatable="yes">Absolutely First</item>
                  <item id="1" translatable="yes">Left</item>
                  <item id="2" translatable="yes">Right</item>
                  <item id="3" translatable="yes">Absolutely Last</item>
                </items>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">System indicators position</property>
            <property name="subtitle" translatable="yes">Wi-Fi, sound, and battery position in the top panel</property>
            <property name="activatable-widget">system_indicators_placement</property>
            <child>
              <object class="GtkComboBoxText" id="system_indicators_placement">
                <property name="valign">center</property>
                <property name="width-request">150</property>
                <property name="active-id">3</property>
                <items>
                  <item id="0" translatable="yes">Absolutely First</item>
                  <item id="1" translatable="yes">Left</item>
                  <item id="2" translatable="yes">Right</item>
                  <item id="3" translatable="yes">Absolutely Last</item>
                </items>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Desktop Name</property>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Enable desktop name</property>
            <property name="subtitle" translatable="yes">Show desktop name label in top panel</property>
            <property name="activatable-widget">show_desktop_name</property>
            <child>
              <object class="GtkSwitch" id="show_desktop_name">
                <property name="valign">center</property>
                <property name="active">1</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Desktop name label</property>
            <property name="subtitle" translatable="yes">Text to use as desktop name label</property>
            <property name="activatable-widget">desktop_name_text</property>
            <child>
              <object class="GtkEntry" id="desktop_name_text">
                <property name="valign">center</property>
                <property name="max-width-chars">12</property>
                <property name="width-request">130</property>
                <property name="text" translatable="yes">GNOME Desktop</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="AdwPreferencesPage" id="windows_page">
    <property name="name">appearance-page</property>
    <property name="title" translatable="yes">Windows</property>
    <property name="icon-name">image-x-generic-symbolic</property>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Behavior</property>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Primary screen only</property>
            <property name="subtitle" translatable="yes">Restrict functionalities to the primary screen</property>
            <property name="activatable-widget">restrict_to_primary_screen</property>
            <child>
              <object class="GtkSwitch" id="restrict_to_primary_screen">
                <property name="valign">center</property>
                <property name="active">1</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Auto focus</property>
            <property name="subtitle" translatable="yes">Auto focus new windows</property>
            <property name="activatable-widget">autofocus_windows</property>
            <child>
              <object class="GtkSwitch" id="autofocus_windows">
                <property name="valign">center</property>
                <property name="active">1</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Panel click actions</property>
            <property name="subtitle" translatable="yes">Enable titlebar actions on top panel click</property>
            <property name="activatable-widget">enable_titlebar_actions</property>
            <child>
              <object class="GtkSwitch" id="enable_titlebar_actions">
                <property name="valign">center</property>
                <property name="active">1</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Titlebars</property>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Hide titlebars</property>
            <property name="subtitle" translatable="yes">Hide window titlebars</property>
            <property name="activatable-widget">hide_window_titlebars</property>
            <child>
              <object class="GtkComboBoxText" id="hide_window_titlebars">
                <property name="valign">center</property>
                <property name="width-request">130</property>
                <property name="active-id">2</property>
                <items>
                  <item id="0" translatable="yes">Never</item>
                  <item id="1" translatable="yes">Tiled</item>
                  <item id="2" translatable="yes">Maximized</item>
                  <item id="3" translatable="yes">Both</item>
                  <item id="4" translatable="yes">Always</item>
                </items>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Show appmenu title</property>
            <property name="subtitle" translatable="yes">Show window title in top panel appmenu</property>
            <property name="activatable-widget">show_window_title</property>
            <child>
              <object class="GtkComboBoxText" id="show_window_title">
                <property name="valign">center</property>
                <property name="width-request">130</property>
                <property name="active-id">2</property>
                <items>
                  <item id="0" translatable="yes">Never</item>
                  <item id="1" translatable="yes">Tiled</item>
                  <item id="2" translatable="yes">Maximized</item>
                  <item id="3" translatable="yes">Both</item>
                  <item id="4" translatable="yes">Always</item>
                </items>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Buttons</property>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Show buttons</property>
            <property name="subtitle" translatable="yes">Show window buttons in top panel</property>
            <property name="activatable-widget">show_window_buttons</property>
            <child>
              <object class="GtkComboBoxText" id="show_window_buttons">
                <property name="valign">center</property>
                <property name="width-request">130</property>
                <property name="active-id">2</property>
                <items>
                  <item id="0" translatable="yes">Never</item>
                  <item id="1" translatable="yes">Tiled</item>
                  <item id="2" translatable="yes">Maximized</item>
                  <item id="3" translatable="yes">Both</item>
                  <item id="4" translatable="yes">Always</item>
                </items>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Button location</property>
            <property name="subtitle" translatable="yes">Keep buttons separate or place them inside another panel item</property>
            <property name="activatable-widget">window_buttons_container</property>
            <child>
              <object class="GtkComboBoxText" id="window_buttons_container">
                <property name="valign">center</property>
                <property name="width-request">170</property>
                <property name="active-id">separate</property>
                <items>
                  <item id="separate" translatable="yes">Separate</item>
                  <item id="appmenu" translatable="yes">AppMenu</item>
                  <item id="workspace" translatable="yes">Workspace Switcher</item>
                </items>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Button order</property>
            <property name="subtitle" translatable="yes">Order of close, maximize, and minimize buttons</property>
            <property name="activatable-widget">window_buttons_order</property>
            <child>
              <object class="GtkComboBoxText" id="window_buttons_order">
                <property name="valign">center</property>
                <property name="width-request">170</property>
                <property name="active-id">native</property>
                <items>
                  <item id="native" translatable="yes">Native</item>
                  <item id="left" translatable="yes">Left — Close, Max, Min</item>
                  <item id="right" translatable="yes">Right — Min, Max, Close</item>
                </items>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow" id="workspace_buttons_animation_duration_row">
            <property name="title" translatable="yes">Animation speed</property>
            <property name="subtitle" translatable="yes">Duration in milliseconds; lower values are faster</property>
            <property name="activatable-widget">workspace_buttons_animation_duration</property>
            <child>
              <object class="GtkSpinButton" id="workspace_buttons_animation_duration">
                <property name="valign">center</property>
                <property name="width-request">170</property>
                <property name="text">200</property>
                <property name="adjustment">workspace_buttons_animation_duration_adjustment</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow" id="workspace_buttons_animation_direction_row">
            <property name="title" translatable="yes">Animation direction</property>
            <property name="subtitle" translatable="yes">Direction window buttons enter from</property>
            <property name="activatable-widget">workspace_buttons_animation_direction</property>
            <child>
              <object class="GtkComboBoxText" id="workspace_buttons_animation_direction">
                <property name="valign">center</property>
                <property name="width-request">170</property>
                <property name="active-id">bottom</property>
                <items>
                  <item id="bottom" translatable="yes">Bottom</item>
                  <item id="top" translatable="yes">Top</item>
                </items>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow" id="reveal_window_buttons_on_hover_row">
            <property name="title" translatable="yes">Reveal buttons on hover</property>
            <property name="subtitle" translatable="yes">Show hidden window buttons while hovering over the combined app menu</property>
            <property name="activatable-widget">reveal_window_buttons_on_hover</property>
            <child>
              <object class="GtkSwitch" id="reveal_window_buttons_on_hover">
                <property name="valign">center</property>
                <property name="active">0</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow" id="window_buttons_hover_delay_row">
            <property name="title" translatable="yes">Button hover delay</property>
            <property name="subtitle" translatable="yes">Delay before hidden window buttons appear</property>
            <property name="activatable-widget">window_buttons_hover_delay</property>
            <child>
              <object class="GtkSpinButton" id="window_buttons_hover_delay">
                <property name="valign">center</property>
                <property name="width-request">130</property>
                <property name="text">350</property>
                <property name="adjustment">window_buttons_hover_delay_adjustment</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Panel position</property>
            <property name="subtitle" translatable="yes">Window buttons position in top panel</property>
            <property name="activatable-widget">window_buttons_placement</property>
            <child>
              <object class="GtkComboBoxText" id="window_buttons_placement">
                <property name="valign">center</property>
                <property name="width-request">130</property>
                <property name="active-id">0</property>
                <items>
                  <item id="0" translatable="yes">Auto</item>
                  <item id="1" translatable="yes">Left</item>
                  <item id="2" translatable="yes">Right</item>
                  <item id="3" translatable="yes">First</item>
                  <item id="4" translatable="yes">Last</item>
                </items>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Icon theme</property>
            <property name="subtitle" translatable="yes">Top panel window buttons theme</property>
            <property name="activatable-widget">window_buttons_theme</property>
            <child>
              <object class="GtkComboBoxText" id="window_buttons_theme">
                <property name="valign">center</property>
                <property name="width-request">130</property>
                <property name="active-id">default-dark</property>
                <items>
                  <item id="auto" translatable="yes">Auto</item>
                  <item id="default" translatable="yes">Default</item>
                  <item id="native" translatable="yes">Native</item>
                </items>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow" id="native_icon_style_row">
            <property name="title" translatable="yes">Native Icon Style</property>
            <property name="subtitle" translatable="yes">GTK version used for native button styling</property>
            <property name="activatable-widget">native_icon_style</property>
            <child>
              <object class="GtkComboBoxText" id="native_icon_style">
                <property name="valign">center</property>
                <property name="width-request">130</property>
                <property name="active-id">gtk3</property>
                <items>
                  <item id="gtk4" translatable="yes">GTK4</item>
                  <item id="gtk3" translatable="yes">GTK3</item>
                </items>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Apply icon scale fix (experimental)</property>
            <property name="subtitle" translatable="yes">Icons are properly rendered for multiple different display scales</property>
            <property name="activatable-widget">icon_scale_workaround</property>
            <child>
              <object class="GtkSwitch" id="icon_scale_workaround">
                <property name="valign">center</property>
                <property name="active">1</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
